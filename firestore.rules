rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /neoqr_codes/{qrId} {
      // QR codes are public for reading so scanned links load smoothly
      allow read: if true;
      // Allow creating and saving QR codes
      allow create: if true;
      // Allow updating and deleting
      allow update, delete: if true;

      // Scans subcollection for analytics tracking
      match /scans/{scanId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAuthenticated();
      }
    }
  }
}
